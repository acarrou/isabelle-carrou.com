---
import { getCollection, render } from "astro:content";
import { profile } from "../data/profile";

const jobs = (await getCollection("jobs")).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(jobs.map(async (j) => ({ ...j, Content: (await render(j)).Content })));
const accents = ["butter", "sage", "blush", "slate"];
---

<section id="experience" class="mx-auto max-w-7xl px-5 md:px-10 pt-20 md:pt-28 scroll-mt-20" data-accent="sage">
  <div class="flex flex-wrap items-end justify-between gap-6 reveal">
    <div>
      <div class="label text-sage">Experience</div>
      <h2 class="display mt-2 text-[clamp(2.6rem,7vw,5.5rem)]">Where I've worked.</h2>
    </div>
    <a href={profile.resume} target="_blank" rel="noopener" class="btn btn-outline">
      Full resume (PDF)
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0-4-4m4 4 4-4M4 20h16"/></svg>
    </a>
  </div>

  <ol class="mt-8 md:mt-10 grid md:grid-cols-2 gap-4 md:gap-5 reveal-stagger">
    {rendered.map((j, i) => (
      <li class="card p-6 md:p-7 flex flex-col gap-3" data-accent={accents[i % accents.length]}>
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip chip-accent">{j.data.date}</span>
          {j.data.current && (
            <span class="inline-flex items-center gap-1.5 label !text-[0.62rem] text-sage">
              <span class="w-1.5 h-1.5 rounded-full bg-sage animate-pulse"></span> Current
            </span>
          )}
        </div>
        <div>
          <h3 class="display text-2xl md:text-3xl">{j.data.title}</h3>
          <p class="mt-1 font-medium text-ink-soft">{j.data.org}</p>
        </div>
        <div class="prose-ic text-[0.92rem] leading-relaxed text-ink-soft">
          <j.Content />
        </div>
      </li>
    ))}
  </ol>
</section>
