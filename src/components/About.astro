---
import { profile } from "../data/profile";
import { Image } from "astro:assets";
const { education } = profile;
const photos = import.meta.glob<ImageMetadata>("../assets/profile.{jpg,png}", { eager: true, import: "default" });
const photo = Object.values(photos)[0] ?? null;
const toolGroups = [
  { name: "Adobe", items: ["Photoshop", "Illustrator", "InDesign", "Premiere Pro", "After Effects"] },
  { name: "Design & 3D", items: ["Figma", "Canva", "Procreate", "Blender", "Substance Painter", "InShot"] },
  { name: "Web & interactive", items: ["HTML", "CSS", "JavaScript", "Twine", "Wix"] },
];
---

<section id="about" class="mx-auto max-w-7xl px-5 md:px-10 pt-20 md:pt-28 scroll-mt-20" data-accent="lilac">
  <div class="reveal">
    <div class="label text-lilac">About</div>
    <h2 class="display mt-2 text-[clamp(2.6rem,7vw,5.5rem)]">Hi, I'm Isabelle.</h2>
  </div>

  <div class="mt-8 md:mt-10 grid lg:grid-cols-12 gap-8 lg:gap-12">
    <div class="lg:col-span-7 reveal">
      <div class="card p-6 md:p-8 flex flex-col sm:flex-row gap-6">
        {photo && <Image src={photo} alt={profile.name} width={320} height={320} class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl object-cover shrink-0" />}
        <div>
          <p class="text-lg md:text-xl leading-relaxed">
            I'm a designer studying <strong class="font-semibold">Art &amp; Design: Games + Playable Media</strong> at UC Santa Cruz,
            {profile.education.grad.toLowerCase()}. My work spans social media campaigns, branding, editorial layout, illustration,
            3D character work, interactive games, and short animation.
          </p>
          <p class="mt-4 text-base md:text-lg leading-relaxed text-ink-soft">
            {profile.blurb}
          </p>
          <p class="mt-4 text-base md:text-lg leading-relaxed text-ink-soft italic">
            “{profile.tagline}”
          </p>
        </div>
      </div>

      <div class="mt-4 plate p-5 md:p-6 flex flex-wrap items-center gap-x-8 gap-y-3">
        <div>
          <div class="label text-ink-soft">Education</div>
          <div class="mt-1 font-semibold">{education.school}</div>
          <div class="text-sm text-ink-soft">{education.degree}</div>
        </div>
        <div class="flex gap-8 sm:ml-auto">
          <div><div class="label text-ink-soft">GPA</div><div class="display text-3xl mt-1">{education.gpa}</div></div>
          <div><div class="label text-ink-soft">Graduating</div><div class="display text-3xl mt-1">{profile.classOf}</div></div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 grid sm:grid-cols-2 lg:grid-cols-1 gap-4">
      <div class="card p-6 reveal">
        <div class="label text-mute mb-3">What I'm good at</div>
        <ul class="prose-ic text-[0.92rem] text-ink-soft">
          {profile.skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="card p-6 reveal-stagger flex flex-col gap-5">
        {toolGroups.map((g) => (
          <div>
            <div class="label text-mute mb-2">{g.name}</div>
            <ul class="flex flex-wrap gap-2">
              {g.items.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
