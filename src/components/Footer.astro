---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer id="contact" class="mt-20 md:mt-28 bg-forest text-paper scroll-mt-20 relative overflow-hidden" data-accent="butter">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 -right-20 w-[34rem] h-[34rem] rounded-full bg-sage/30 blur-3xl"></div>
  <div class="relative mx-auto max-w-7xl px-5 md:px-10 py-16 md:py-24">
    <div class="label text-butter reveal">Let's work together</div>
    <h2 class="display mt-3 text-[clamp(3rem,10vw,8rem)] reveal">Say hello.</h2>
    <p class="mt-5 max-w-xl text-lg text-paper/80 reveal">
      {profile.availability}. Based in {profile.location}, happy to work remote or in person around the Bay Area.
    </p>

    <div class="mt-10 md:mt-12 grid md:grid-cols-12 gap-8 reveal">
      <div class="md:col-span-7">
        <a href={`mailto:${profile.email}`} class="display text-[clamp(1.5rem,4.5vw,3.6rem)] break-all hover:text-butter underline decoration-paper/30 hover:decoration-butter underline-offset-8 decoration-4 transition-colors">{profile.email}</a>
      </div>
      <div class="md:col-span-5 flex flex-wrap md:justify-end gap-3 content-start">
        <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-light">LinkedIn</a>
        <a href={profile.resume} target="_blank" rel="noopener" class="btn btn-light">Resume (PDF)</a>
        <a href={profile.portfolioPdf} target="_blank" rel="noopener" class="btn btn-light">Portfolio (PDF)</a>
      </div>
    </div>

    <div class="mt-16 md:mt-20 pt-6 border-t border-paper/15 flex flex-wrap justify-between gap-4 text-xs text-paper/50">
      <span>&copy; {year} {profile.name}. All rights reserved.</span>
      <a href="#top" class="hover:text-paper transition-colors">Back to top ↑</a>
    </div>
  </div>
</footer>
