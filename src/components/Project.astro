---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}
const { project, index } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const pad = (n: number) => String(n).padStart(2, "0");
const bare = data.tone === "bare";

// Pre-render a large version of every image for the lightbox
const gallery = await Promise.all(
  data.images.map(async (img) => {
    const full = await getImage({ src: img.src, width: 1600, format: "webp", quality: 82 });
    return { ...img, full: full.src };
  }),
);

const colClass: Record<number, string> = {
  1: "md:grid-cols-1",
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
};
const spanClass: Record<number, string> = {
  1: "",
  2: "md:col-span-2",
  3: "md:col-span-3",
  4: "md:col-span-4",
};
const textFirst = data.align === "left";
---

<article id={project.id} class="mx-auto max-w-7xl px-5 md:px-10 pt-16 md:pt-24 scroll-mt-16">
  <div class="rule"></div>
  <div class="flex items-center justify-between gap-4 pt-3 label text-ink-soft">
    <span class="whitespace-nowrap">{pad(index)} / Project</span>
    <span class="text-right">{data.kicker}</span>
  </div>

  <h2 class="display mt-6 md:mt-8 text-[clamp(3rem,9.5vw,8.5rem)] max-w-[14ch] reveal">
    {data.title}
  </h2>

  {data.lead && (
    <p class="mt-6 md:mt-8 max-w-4xl text-lg md:text-2xl italic leading-relaxed text-ink reveal">
      {data.lead}
    </p>
  )}

  <div class="mt-10 md:mt-14 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <div class:list={["lg:col-span-4 flex flex-col gap-7 reveal", textFirst ? "lg:order-1" : "lg:order-2"]}>
      <div class="prose-ic text-[0.98rem] md:text-base leading-relaxed text-ink-soft">
        <Content />
      </div>

      {data.tools.length > 0 && (
        <div>
          <div class="label text-mute mb-2.5">Tools</div>
          <ul class="flex flex-wrap gap-2">
            {data.tools.map((t) => (
              <li class="plate px-2.5 py-1 text-xs font-semibold uppercase tracking-wider">{t}</li>
            ))}
          </ul>
        </div>
      )}

      {data.links.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {data.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="btn-outline">
              {l.label}
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7m0 0H8m9 0v9"/></svg>
            </a>
          ))}
        </div>
      )}
    </div>

    <div
      class:list={[
        "lg:col-span-8 grid grid-cols-2 gap-3 md:gap-4 reveal-stagger",
        colClass[data.columns],
        bare ? "items-end" : "",
        textFirst ? "lg:order-2" : "lg:order-1",
      ]}
      data-gallery={project.id}
    >
      {gallery.map((img, i) => {
        const isVideo = img.kind === "video";
        const Tag = isVideo ? "a" : "button";
        const attrs = isVideo
          ? { href: img.href, target: "_blank", rel: "noopener", "aria-label": `Watch: ${img.alt}` }
          : {
              type: "button",
              "aria-label": `View larger: ${img.alt}`,
              "data-lightbox": img.full,
              "data-alt": img.alt,
              "data-href": img.href ?? "",
              "data-index": String(i),
            };
        return (
          <Tag
            class:list={[
              "tile",
              bare && "tile-bare",
              isVideo && "tile-video",
              spanClass[img.span],
              img.span > 1 && "col-span-2",
            ]}
            {...attrs}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[420, 720, 1080, 1440]}
              sizes={img.span > 1 ? "(min-width: 1024px) 60vw, 100vw" : "(min-width: 1024px) 30vw, 50vw"}
              class:list={[bare ? "max-h-[420px] w-auto mx-auto" : "", img.fit === "contain" && "!object-contain p-3"]}
              style={bare ? undefined : `aspect-ratio: ${img.aspect ?? (img.span > 1 ? "16 / 9" : "3 / 4")};`}
              loading={index <= 1 ? "eager" : "lazy"}
            />
            {isVideo && (
              <span class="badge">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                Watch
              </span>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</article>
