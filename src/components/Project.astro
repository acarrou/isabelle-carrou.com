---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}
const { project, index } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const pad = (n: number) => String(n).padStart(2, "0");
const bare = data.tone === "bare";

// Turn a share link into something that can play inline
function embedFor(href?: string): { url: string; portrait: boolean } | null {
  if (!href) return null;
  const yt = href.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([\w-]{6,})/);
  if (yt) return { url: `https://www.youtube.com/embed/${yt[1]}?autoplay=1&rel=0`, portrait: /shorts/.test(href) };
  const dr = href.match(/drive\.google\.com\/file\/d\/([\w-]+)/);
  if (dr) return { url: `https://drive.google.com/file/d/${dr[1]}/preview`, portrait: false };
  return null;
}

const gallery = await Promise.all(
  data.images.map(async (img) => {
    const full = await getImage({ src: img.src, width: 1600, format: "webp", quality: 82 });
    const embed = img.kind === "video" ? embedFor(img.href) : null;
    // vertical reels get a portrait player
    const portrait = img.src.height > img.src.width;
    return { ...img, full: full.src, embed: embed ? { ...embed, portrait: embed.portrait || portrait } : null };
  }),
);

const colClass: Record<number, string> = { 1: "md:grid-cols-1", 2: "md:grid-cols-2", 3: "md:grid-cols-3", 4: "md:grid-cols-4" };
const spanClass: Record<number, string> = { 1: "", 2: "md:col-span-2", 3: "md:col-span-3", 4: "md:col-span-4" };
const textFirst = data.align === "left";
---

<article id={project.id} class="mx-auto max-w-7xl px-5 md:px-10 pt-16 md:pt-24 scroll-mt-16" data-accent={data.accent}>
  <div class="flex items-center justify-between gap-4 label text-mute">
    <span class="whitespace-nowrap flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full" style="background: var(--accent)"></span>
      {pad(index)}
    </span>
    <span class="text-right text-ink-soft">{data.kicker}</span>
  </div>

  <h2 class="display mt-5 md:mt-6 text-[clamp(2.6rem,7.5vw,6.5rem)] max-w-[16ch] reveal">
    {data.title}
  </h2>

  {data.lead && (
    <p class="mt-5 md:mt-6 max-w-3xl text-lg md:text-xl leading-relaxed text-ink reveal">
      {data.lead}
    </p>
  )}

  {data.pending ? (
    <div class="mt-8 md:mt-10 card p-6 md:p-8 grid md:grid-cols-12 gap-8 reveal">
      <div class="md:col-span-7 prose-ic text-[0.98rem] leading-relaxed text-ink-soft">
        <Content />
        {data.tools.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-6">
            {data.tools.map((t) => <li class="chip">{t}</li>)}
          </ul>
        )}
      </div>
      <div class="md:col-span-5 plate p-5 md:p-6">
        <div class="label text-ink-soft mb-3">In progress</div>
        <ul class="prose-ic text-sm text-ink">
          {data.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  ) : (
    <div class="mt-8 md:mt-12 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class:list={["lg:col-span-4 flex flex-col gap-6 reveal", textFirst ? "lg:order-1" : "lg:order-2"]}>
        {data.results.length > 0 && (
          <div class="grid grid-cols-2 gap-3">
            {data.results.map((r) => (
              <div class="plate p-4">
                <div class="display text-3xl md:text-4xl">{r.value}</div>
                <div class="text-xs mt-1 text-ink-soft">{r.label}</div>
              </div>
            ))}
          </div>
        )}

        {data.highlights.length > 0 && (
          <div class="plate p-5">
            <div class="label text-ink-soft mb-2.5">Highlights</div>
            <ul class="prose-ic text-sm text-ink">
              {data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        )}

        <div class="prose-ic text-[0.95rem] leading-relaxed text-ink-soft">
          <Content />
        </div>

        {data.tools.length > 0 && (
          <div>
            <div class="label text-mute mb-2.5">Tools</div>
            <ul class="flex flex-wrap gap-2">
              {data.tools.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        )}

        {data.links.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {data.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" class="btn btn-accent">
                {l.label}
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7m0 0H8m9 0v9"/></svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <div
        class:list={[
          "lg:col-span-8 grid grid-cols-2 gap-3 md:gap-4 reveal-stagger",
          colClass[data.columns],
          bare ? "items-end" : "",
          textFirst ? "lg:order-2" : "lg:order-1",
        ]}
        data-gallery={project.id}
      >
        {gallery.map((img) => {
          const isVideo = img.kind === "video";
          const attrs = isVideo && img.embed
            ? { type: "button", "aria-label": `Play: ${img.alt}`, "data-embed": img.embed.url, "data-portrait": String(img.embed.portrait), "data-alt": img.alt, "data-href": img.href ?? "" }
            : isVideo
              ? null
              : { type: "button", "aria-label": `View larger: ${img.alt}`, "data-lightbox": img.full, "data-alt": img.alt, "data-href": img.href ?? "" };
          const inner = (
            <>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[420, 720, 1080, 1440]}
                sizes={img.span > 1 ? "(min-width: 1024px) 60vw, 100vw" : "(min-width: 1024px) 30vw, 50vw"}
                class:list={[bare ? "max-h-[420px] w-auto mx-auto" : "", img.fit === "contain" && "!object-contain p-3"]}
                style={bare ? undefined : `aspect-ratio: ${img.aspect ?? (img.span > 1 ? "16 / 9" : "3 / 4")};`}
                loading={index <= 1 ? "eager" : "lazy"}
              />
              {isVideo && (
                <span class="play" aria-hidden="true">
                  <span>
                    <svg class="w-5 h-5 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </span>
              )}
            </>
          );
          const cls = ["tile", bare && "tile-bare", isVideo && "tile-video", spanClass[img.span], img.span > 1 && "col-span-2"];
          return attrs ? (
            <button class:list={cls} {...attrs}>{inner}</button>
          ) : (
            <a class:list={cls} href={img.href} target="_blank" rel="noopener" aria-label={`Watch: ${img.alt}`}>{inner}</a>
          );
        })}
      </div>
    </div>
  )}
</article>
