---
import { profile } from "../data/profile";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// Drop a square photo at src/assets/profile.jpg (or .png) to show it here.
const photos = import.meta.glob<ImageMetadata>("../assets/profile.{jpg,png}", { eager: true, import: "default" });
const photo = Object.values(photos)[0] ?? null;

// A few pieces of work peek into the hero so there's art on the first screen
const projects = (await getCollection("projects")).filter((p) => p.data.images.length > 0).sort((a, b) => a.data.order - b.data.order);
const peek = [
  { p: projects.find((p) => p.id.includes("vivian")), i: 0 },
  { p: projects.find((p) => p.id.includes("roots")), i: 1 },
  { p: projects.find((p) => p.id.includes("senate")), i: 0 },
  { p: projects.find((p) => p.id.includes("overglow")), i: 0 },
].filter((x) => x.p);
---

<section id="top" class="relative overflow-hidden" data-accent="coral">
  <!-- soft colour blobs -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full bg-butter-soft blur-3xl opacity-80 float"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 right-[10%] w-[30rem] h-[30rem] rounded-full bg-sage-soft blur-3xl opacity-80 float float-2"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-1/3 right-[-6rem] w-[22rem] h-[22rem] rounded-full bg-blush-soft blur-3xl opacity-70"></div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-10 pt-12 md:pt-20 pb-10 md:pb-16 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
    <div class="lg:col-span-7">
      <div class="flex flex-wrap items-center gap-3 rise">
        {photo && <Image src={photo} alt={profile.name} width={112} height={112} class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow" />}
        <span class="chip chip-accent">
          <span class="w-2 h-2 rounded-full bg-sage mr-2 animate-pulse"></span>
          {profile.availability}
        </span>
      </div>

      <h1 class="display mt-6 md:mt-8 text-[clamp(3.6rem,11vw,9.5rem)] rise rise-2">
        <span class="block">{profile.first}</span>
        <span class="block"><span class="mark">{profile.last}</span></span>
      </h1>

      <p class="mt-5 md:mt-7 text-xl md:text-2xl font-medium leading-snug max-w-2xl rise rise-3">
        {profile.title}
      </p>
      <p class="mt-3 text-base md:text-lg leading-relaxed text-ink-soft max-w-xl rise rise-3">
        {profile.intro}
      </p>

      <div class="mt-8 flex flex-wrap gap-3 rise rise-4">
        <a href="#work" class="btn btn-ink">
          See my work
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6"/></svg>
        </a>
        <a href={`mailto:${profile.email}`} class="btn btn-outline">Email me</a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-outline">LinkedIn</a>
      </div>

      <p class="mt-8 text-sm text-mute rise rise-4">
        {profile.location} · {profile.school}, {profile.education.degree.replace("B.A. in ", "")}
      </p>
    </div>

    <!-- work peek: a little stack of her pieces -->
    <div class="lg:col-span-5 relative h-[22rem] sm:h-[26rem] lg:h-[30rem] rise rise-3" aria-hidden="true">
      {peek.map(({ p, i }, n) => {
        const img = p!.data.images[i];
        const pos = [
          "left-[4%] top-[6%] w-[46%] rotate-[-6deg]",
          "right-[6%] top-[0%] w-[38%] rotate-[5deg]",
          "left-[22%] bottom-[2%] w-[40%] rotate-[3deg]",
          "right-[2%] bottom-[8%] w-[34%] rotate-[-4deg]",
        ][n];
        return (
          <a href={`#${p!.id}`} class:list={["absolute block rounded-2xl overflow-hidden shadow-xl bg-white transition-transform hover:scale-[1.04] hover:z-10", pos]} data-accent={p!.data.accent}>
            <Image src={img.src} alt="" widths={[320, 640]} sizes="30vw" class="w-full h-auto object-cover" style={p!.data.tone === "bare" ? "" : "aspect-ratio: 3 / 4"} loading="eager" />
          </a>
        );
      })}
    </div>
  </div>
</section>
