---
import { SEO } from "astro-seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { profile } from "../data/profile";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? `${profile.name} | ${profile.title}`;
const description =
  Astro.props.description ??
  `Portfolio of ${profile.name}, a graphic and marketing designer (UC Santa Cruz, class of 2027). Social media content, branding, illustration, 3D, and animation.`;

const siteUrl = Astro.site?.toString() ?? "/";
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : siteUrl;
const ogImage = new URL("/og.png", siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e9e8e1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO
      title={title}
      description={description}
      canonical={url}
      openGraph={{
        basic: { url, title, type: "website", image: ogImage },
        optional: { description, siteName: profile.name },
      }}
      twitter={{ card: "summary_large_image", title, description, image: ogImage }}
      extend={{
        meta: [
          { name: "author", content: profile.name },
          {
            name: "keywords",
            content:
              "graphic designer, marketing designer, social media content, motion graphics, branding, illustration, UC Santa Cruz, Bay Area designer, portfolio",
          },
        ],
      }}
    />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#work"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] btn-ink"
      >Skip to work</a
    >
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <Lightbox />

    <script>
      // Scroll reveal
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal, .reveal-stagger");
      if (prefersReduced || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }

      // Highlight the current section in the nav
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
      const sections = links
        .map((l) => document.querySelector<HTMLElement>(l.getAttribute("href") || ""))
        .filter((s): s is HTMLElement => !!s);
      if (sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                links.forEach((l) =>
                  l.setAttribute("aria-current", l.getAttribute("href") === `#${e.target.id}` ? "true" : "false"),
                );
              }
            }
          },
          { rootMargin: "-40% 0px -55% 0px" },
        );
        sections.forEach((s) => spy.observe(s));
      }
    </script>
  </body>
</html>
