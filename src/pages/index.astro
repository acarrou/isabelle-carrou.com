---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Featured from "../components/Featured.astro";
import Project from "../components/Project.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import GroupDivider from "../components/GroupDivider.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <Hero />
  <Ticker />
  <Featured projects={projects} />
  {projects.map((p, i) => (
    <>
      {(i === 0 || projects[i - 1].data.group !== p.data.group) && (
        <GroupDivider label={p.data.group === "work" ? "Work Experience" : "Personal Projects"} />
      )}
      <Project project={p} index={i + 1} />
    </>
  ))}
  <Experience />
  <About />
</BaseLayout>
