---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Isabelle Carrou">
  <section class="mx-auto max-w-7xl px-5 md:px-10 py-24 md:py-40">
    <div class="label text-ink-soft">Error 404</div>
    <h1 class="display mt-6 text-[clamp(4rem,16vw,14rem)]">Not<br />found.</h1>
    <p class="mt-8 text-lg text-ink-soft max-w-md">That page doesn't exist. Head back to the portfolio.</p>
    <a href="/" class="btn btn-ink mt-8">Back home</a>
  </section>
</BaseLayout>
